# OmniRouter configuration template.
#
# Copy this file to `.env` in the same directory and fill in the real values.
# The operator pre-populates the keys from Infisical — this process does NOT
# make live Infisical API calls.
#
#   cp .env.example .env
#   # then paste the secrets pulled from Infisical
#
# .env is gitignored (see cortextos/.gitignore). Never commit real keys.

# --- API keys ---------------------------------------------------------------

# Primary Anthropic API key. Used in DIRECT state. This is the same key the
# fleet normally uses; the proxy injects it as the x-api-key header.
ANTHROPIC_API_KEY=sk-ant-PRIMARY-KEY-HERE

# Fallback Anthropic API key. Used in FALLBACK / RECOVERING states.
# In Infisical this secret is named: Claude_Daemon_Fallback_APIKEY
# Pull it with your Infisical CLI/UI and paste the value here.
FALLBACK_API_KEY=sk-ant-FALLBACK-KEY-HERE

# --- State machine tuning ---------------------------------------------------

# HTTP status codes from Anthropic that trigger DIRECT -> FALLBACK.
# 429 = rate limited, 529 = overloaded, 5xx = server errors.
FALLBACK_TRIGGER_CODES=429,529,500,502,503,504

# Consecutive trigger responses required before flipping to FALLBACK.
# Set to 1 to fail over on the very first error.
FAILURES_TO_TRIP=2

# How long to stay in FALLBACK before entering RECOVERING (ms).
FALLBACK_HOLD_MS=60000

# While RECOVERING, probe the primary key every N ms.
RECOVERY_PROBE_INTERVAL_MS=15000

# Timeout for each recovery probe request (ms).
RECOVERY_PROBE_TIMEOUT_MS=10000

# --- Listener / upstream (defaults are correct for the standard setup) ------

# Where the proxy listens. Agents point ANTHROPIC_BASE_URL here.
OMNIROUTER_PORT=20128
OMNIROUTER_HOST=127.0.0.1

# Anthropic upstream. Leave as-is unless using a regional/proxy endpoint.
UPSTREAM_HOST=api.anthropic.com
UPSTREAM_PORT=443
